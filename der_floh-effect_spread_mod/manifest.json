{
    "name": "effect_spread_mod",
    "namespace": "der_floh",
    "version_number": "1.0.3",
    "description": "When a tile with poison, fire or water effects is destroyed while still having ticks left, those effects spread to nearby ores in a configurable radius.",
    "website_url": "",
    "dependencies": [],
    "extra": {
        "godot": {
            "authors": [
                "der_floh"
            ],
            "tags": [
                "gameplay"
            ],
            "description_rich": "",
            "optional_dependencies": [],
            "load_before": [],
            "incompatibilities": [],
            "config_schema": {
                "title": "Config",
                "description": "Config for Effect Spread",
                "type": "object",
                "properties": {
                    "spread_radius": {
                        "title": "Spread Radius",
                        "type": "number",
                        "default": 3
                    },
                    "inherit_ticks": {
                        "title": "Inherit Ticks",
                        "type": "boolean",
                        "default": true
                    },
                    "fresh_ticks": {
                        "title": "Fresh Ticks",
                        "type": "number",
                        "default": 10
                    },
                    "debug_logging": {
                        "title": "Debug Logging",
                        "type": "boolean",
                        "default": false
                    }
                }
            },
            "compatible_mod_loader_version": [
                "7.0.1"
            ],
            "compatible_game_version": [
                "1.4.1.1"
            ]
        }
    }
}